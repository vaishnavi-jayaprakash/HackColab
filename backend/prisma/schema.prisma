generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String   @id @default(uuid())
  name           String
  email          String   @unique
  passwordHash   String
  githubUsername String?
  githubId       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  teamMembers         TeamMember[]
  assignedTasks       Task[]
  uploads             Upload[]
  assignedSubmissions SubmissionItem[]
  teamLeads           Team[]           @relation("TeamLead")
}

model Hackathon {
  id                 String    @id @default(uuid())
  name               String
  description        String?
  organizerName      String?
  startDate          DateTime
  endDate            DateTime
  submissionDeadline DateTime?
  status             String
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  teams     Team[]
  deadlines Deadline[]
}

model Team {
  id          String   @id @default(uuid())
  hackathonId String
  name        String
  description String?
  leadId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  hackathon Hackathon @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  lead      User      @relation("TeamLead", fields: [leadId], references: [id])

  members         TeamMember[]
  tasks           Task[]
  repositories    Repository[]
  uploads         Upload[]
  submissionItems SubmissionItem[]

  @@index([hackathonId])
  @@index([leadId])
}

model TeamMember {
  id       String   @id @default(uuid())
  teamId   String
  userId   String
  role     String
  joinedAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
}

model Task {
  id          String    @id @default(uuid())
  teamId      String
  title       String
  description String?
  status      String
  priority    String
  assigneeId  String?
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  team     Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  assignee User? @relation(fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([teamId])
  @@index([assigneeId])
}

model Deadline {
  id          String   @id @default(uuid())
  hackathonId String
  title       String
  description String?
  deadlineAt  DateTime
  type        String
  createdAt   DateTime @default(now())

  hackathon Hackathon @relation(fields: [hackathonId], references: [id], onDelete: Cascade)

  @@index([hackathonId])
}

model Repository {
  id             String    @id @default(uuid())
  teamId         String
  provider       String
  name           String
  url            String
  externalRepoId String?
  defaultBranch  String
  connectedAt    DateTime  @default(now())
  lastSyncedAt   DateTime?

  team         Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  branches     Branch[]
  pullRequests PullRequest[]
  conflicts    Conflict[]

  @@index([teamId])
}

model Branch {
  id             String    @id @default(uuid())
  repositoryId   String
  name           String
  lastCommitHash String?
  lastActivityAt DateTime?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())

  repository     Repository     @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  fileActivities FileActivity[]

  conflictsAsA Conflict[] @relation("ConflictBranchA")
  conflictsAsB Conflict[] @relation("ConflictBranchB")

  @@index([repositoryId])
}

model PullRequest {
  id           String   @id @default(uuid())
  repositoryId String
  externalPrId String
  title        String
  url          String
  sourceBranch String
  targetBranch String
  authorName   String?
  status       String
  createdAt    DateTime
  updatedAt    DateTime

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@index([repositoryId])
}

model FileActivity {
  id             String   @id @default(uuid())
  branchId       String
  commitHash     String
  filePath       String
  changeType     String
  authorName     String?
  authorGithubId String?
  timestamp      DateTime

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([branchId])
  @@index([filePath])
}

model Conflict {
  id           String    @id @default(uuid())
  repositoryId String
  branchAId    String
  branchBId    String
  filePath     String
  status       String
  detectedAt   DateTime  @default(now())
  resolvedAt   DateTime?

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  branchA Branch @relation("ConflictBranchA", fields: [branchAId], references: [id], onDelete: Cascade)
  branchB Branch @relation("ConflictBranchB", fields: [branchBId], references: [id], onDelete: Cascade)

  @@index([repositoryId])
  @@index([branchAId])
  @@index([branchBId])
}

model Upload {
  id         String   @id @default(uuid())
  teamId     String
  uploadedBy String
  fileName   String
  s3Key      String
  fileUrl    String?
  fileType   String?
  fileSize   Int?
  createdAt  DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [uploadedBy], references: [id], onDelete: Cascade)

  submissionItems SubmissionItem[]

  @@index([teamId])
  @@index([uploadedBy])
}

model SubmissionItem {
  id          String   @id @default(uuid())
  teamId      String
  title       String
  description String?
  required    Boolean  @default(true)
  status      String
  assignedTo  String?
  uploadId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  team     Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  assignee User?   @relation(fields: [assignedTo], references: [id], onDelete: SetNull)
  upload   Upload? @relation(fields: [uploadId], references: [id], onDelete: SetNull)

  @@index([teamId])
  @@index([assignedTo])
  @@index([uploadId])
}
